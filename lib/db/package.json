{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "audit:supabase": "zsh -lc 'source ../../.env && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./sql/audit-supabase-public-schema.sql'",
    "secure:supabase": "zsh -lc 'source ../../.env && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./sql/harden-supabase-public-schema.sql'"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9"
  }
}
